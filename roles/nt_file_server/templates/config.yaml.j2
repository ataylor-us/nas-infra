# {{ ansible_managed }}
source_directories:
  - /srv/samba
repositories:
    - path: '{{ remote_borg_repo_path }}'
      label: "remote"
{% if local_borg_repo is defined %}
    - path: '{{ local_borg_repo }}'
      label: "local"
{% endif %}
exclude_patterns:
  - /srv/samba/timemachine-*
compression: lz4
encryption_passphrase: '{{ borg_passphrase }}'
archive_name_format: 'shares-{hostname}-{now:%Y-%m-%d-%H%M%S}'
read_special: true
retries: 5
retry_wait: 5
keep_within: 10d
keep_daily: 5
keep_weekly: 4
keep_monthly: 3
keep_yearly: 2
